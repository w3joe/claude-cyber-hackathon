    "@type": "odrl:Set",
    "uid": "urn:mandate:policy:POL-02",
    "profile": "urn:mandate:profile:1",
    "conflict": "http://www.w3.org/ns/odrl/2/invalid",
    "dcterms:title": "Account access",
    "obligation": [
      {
        "uid": "urn:mandate:rule:POL-02-2",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:it-lead",
        "action": "urn:mandate:vocab:removeAccess",
        "target": "urn:mandate:system:identity-console",
        "constraint": [],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-02-2"
        },
        "mandate:quote": "The IT Lead must remove studio access for departed colleagues using the Identity Console and record completion.",
        "mandate:assigneeQuote": "IT Lead",
        "mandate:actionQuote": "remove studio access",
        "mandate:targetQuote": "Identity Console"
      },
      {
        "uid": "urn:mandate:rule:POL-02-3",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:reviewAdministratorAccess",
        "target": "urn:mandate:system:publishing-console",
        "constraint": [
          {
            "leftOperand": "urn:mandate:vocab:maximumReviewInterval",
            "operator": "http://www.w3.org/ns/odrl/2/lteq",
            "rightOperand": {
              "@value": "P3M",
              "@type": "http://www.w3.org/2001/XMLSchema#duration"
            },
            "mandate:quote": "at least quarterly"
          }
        ],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-02-3"
        },
        "mandate:quote": "The Head of Media must review administrator access to customer publishing channels at least quarterly.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "review administrator access",
        "mandate:targetQuote": "customer publishing channels"
      }
    ],
    "permission": [
      {
        "uid": "urn:mandate:rule:POL-02-4",
        "@type": "odrl:Permission",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:administerPublishing",
        "target": "urn:mandate:system:publishing-console",
        "constraint": [],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-02-4"
        },
        "mandate:quote": "Studio access removal must follow §2. The Head of Media may administer customer publishing channels.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "administer",
        "mandate:targetQuote": "customer publishing channels"
      }
    ],
    "prohibition": []
  },
