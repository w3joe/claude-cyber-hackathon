    "profile": "urn:mandate:profile:1",
    "conflict": "http://www.w3.org/ns/odrl/2/invalid",
    "dcterms:title": "Asset recovery",
    "obligation": [
      {
        "uid": "urn:mandate:rule:POL-03-2",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:operations-lead",
        "action": "urn:mandate:vocab:testRecovery",
        "target": "urn:mandate:system:asset-library",
        "constraint": [],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-03-2"
        },
        "mandate:quote": "The Operations Lead must perform a recovery exercise for the Asset Library and retain current evidence.",
        "mandate:assigneeQuote": "Operations Lead",
        "mandate:actionQuote": "perform a recovery exercise",
        "mandate:targetQuote": "Asset Library"
      }
    ],
    "permission": [],
    "prohibition": []
  },
