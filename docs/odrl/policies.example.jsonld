    "@type": "odrl:Set",
    "uid": "urn:mandate:policy:SOW-04",
    "profile": "urn:mandate:profile:1",
    "conflict": "http://www.w3.org/ns/odrl/2/invalid",
    "dcterms:title": "Customer media commitments",
    "obligation": [
      {
        "uid": "urn:mandate:rule:SOW-04-5",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:checkMediaRights",
        "target": "urn:mandate:system:asset-library",
        "constraint": [],
        "dcterms:source": {
          "@id": "urn:mandate:provision:SOW-04-5"
        },
        "mandate:quote": "The Head of Media must check media licences and permissions for customer media in the Asset Library.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "check media licences and permissions",
        "mandate:targetQuote": "customer media in the Asset Library"
      },
      {
        "uid": "urn:mandate:rule:SOW-04-4",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:client-lead",
        "action": "urn:mandate:vocab:recordCustomerApproval",
        "target": "urn:mandate:system:campaign-board",
        "constraint": [
          {
            "leftOperand": "urn:mandate:vocab:beforeRelease",
            "operator": "http://www.w3.org/ns/odrl/2/eq",
            "rightOperand": {
              "@value": true,
              "@type": "http://www.w3.org/2001/XMLSchema#boolean"
            },
            "mandate:quote": "before release"
          }
        ],
        "dcterms:source": {
          "@id": "urn:mandate:provision:SOW-04-4"
        },
        "mandate:quote": "The Client Lead must record customer approval for material campaigns before release.",
        "mandate:assigneeQuote": "Client Lead",
        "mandate:actionQuote": "record customer approval",
        "mandate:targetQuote": "material campaigns"
      },
      {
        "uid": "urn:mandate:rule:SOW-04-5.2",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:retainPermissionRecords",
        "target": "urn:mandate:system:asset-library",
        "constraint": [
          {
            "leftOperand": "urn:mandate:vocab:retentionPeriod",
            "operator": "http://www.w3.org/ns/odrl/2/gteq",
            "rightOperand": {
              "@value": "P24M",
              "@type": "http://www.w3.org/2001/XMLSchema#duration"
            },
            "mandate:quote": "at least 24 months"
          }
        ],
        "dcterms:source": {
          "@id": "urn:mandate:provision:SOW-04-5.2"
        },
        "mandate:quote": "The Head of Media must retain permission records in the Asset Library for at least 24 months.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "retain permission records",
        "mandate:targetQuote": "Asset Library"
      }
    ],
    "permission": [],
    "prohibition": []
  }
