    "@type": "odrl:Set",
    "uid": "urn:mandate:policy:POL-01",
    "profile": "urn:mandate:profile:1",
    "conflict": "http://www.w3.org/ns/odrl/2/invalid",
    "dcterms:title": "Material campaign release",
    "obligation": [
      {
        "uid": "urn:mandate:rule:POL-01-3",
        "@type": "odrl:Duty",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:approveCampaign",
        "target": "urn:mandate:system:campaign-board",
        "constraint": [
          {
            "leftOperand": "urn:mandate:vocab:beforeRelease",
            "operator": "http://www.w3.org/ns/odrl/2/eq",
            "rightOperand": {
              "@value": true,
              "@type": "http://www.w3.org/2001/XMLSchema#boolean"
            },
            "mandate:quote": "before release"
          }
        ],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-01-3"
        },
        "mandate:quote": "The Head of Media must approve material campaigns before release and record the decision.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "approve",
        "mandate:targetQuote": "material campaigns"
      }
    ],
    "permission": [],
    "prohibition": [
      {
        "uid": "urn:mandate:rule:POL-01-3.1",
        "@type": "odrl:Prohibition",
        "assignee": "urn:mandate:role:head-media",
        "action": "urn:mandate:vocab:publishUnapprovedCampaign",
        "target": "urn:mandate:system:campaign-board",
        "constraint": [],
        "dcterms:source": {
          "@id": "urn:mandate:provision:POL-01-3.1"
        },
        "mandate:quote": "The Head of Media must not publish an unapproved campaign from the Campaign Board.",
        "mandate:assigneeQuote": "Head of Media",
        "mandate:actionQuote": "publish an unapproved campaign",
        "mandate:targetQuote": "Campaign Board"
      }
    ]
  },
  {
    "@context": {
      "odrl": "http://www.w3.org/ns/odrl/2/",
